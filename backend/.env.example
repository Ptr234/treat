# === Backend Environment Variables ===
# These override appsettings.json values when set.
# Use double-underscore (__) for nested config keys.

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Database=osc_dev;Username=postgres;Password=postgres

# JWT Authentication
Jwt__Secret=your-production-secret-key-minimum-32-characters
Jwt__ExpiryHours=24
Jwt__Issuer=osc-api

# Groq AI (chatbot)
Groq__ApiKey=your-groq-api-key
Groq__Model=llama-3.3-70b-versatile

# Postmark Email
Postmark__ServerToken=your-postmark-server-token
Postmark__FromAddress=notifications@www.oscdigitaltool.com
Postmark__AdminEmail=admin@uia.go.ug

# CORS
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Site URL (used in email links)
SiteUrl=http://localhost:3000
