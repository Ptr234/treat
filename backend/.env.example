# === Backend Environment Variables ===
# These override appsettings.json values when set.
# Use double-underscore (__) for nested config keys.

# Database
ConnectionStrings__DefaultConnection=Host=localhost;Database=osc_dev;Username=postgres;Password=postgres

# JWT Authentication
Jwt__Secret=your-production-secret-key-minimum-32-characters
Jwt__ExpiryHours=24
Jwt__Issuer=osc-api

# Set only when the API must create the first administrator at startup.
# Use a unique secret value; startup skips seeding when this is blank.
Seed__AdminPassword=replace-with-a-unique-initial-admin-password

# Groq AI (chatbot)
Groq__ApiKey=your-groq-api-key
Groq__Model=llama-3.3-70b-versatile

# Postmark Email
Postmark__ServerToken=your-postmark-server-token
Postmark__FromAddress=notifications@www.oscdigitaltool.com
Postmark__AdminEmail=admin@uia.go.ug

# Flutterwave (business registration fee payment)
Flutterwave__SecretKey=your-flutterwave-secret-key
Flutterwave__PublicKey=your-flutterwave-public-key
# From the Flutterwave dashboard's webhook settings — verifies POST /api/payments/flutterwave/webhook
Flutterwave__WebhookSecretHash=your-flutterwave-webhook-secret-hash

# CORS
Cors__AllowedOrigins=http://localhost:3000,http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Site URL (used in email links)
SiteUrl=http://localhost:3000
