# Build-time settings for the VPS build (deploy/deploy-vps.ps1). NEXT_PUBLIC_*
# values are compiled into the browser bundle, so everything here is public.
# Secrets (JWT_SECRET, SANITY_API_TOKEN) live only on the server in /etc/osc-web/env.
NEXT_PUBLIC_BACKEND_URL=https://api.oscdigitaltool.com
NEXT_PUBLIC_SITE_URL=https://oscdigitaltool.com
NEXT_PUBLIC_SANITY_PROJECT_ID=juhrlluw
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
NEXT_PUBLIC_GOOGLE_CLIENT_ID=426492812948-n4oacr87lft97mbi9lmvth7ahlctoblt.apps.googleusercontent.com
