# === Frontend Environment Variables ===

# ASP.NET Backend URL (leave empty to use Next.js API routes)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5082

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_TOKEN=your-sanity-write-token

# Authentication
JWT_SECRET=your-secret-key-minimum-32-characters-long
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Groq AI (for chatbot - only needed if not using backend)
GROQ_API_KEY=your-groq-api-key

# Email (Resend - only needed if not using backend; see src/lib/email.ts)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=notifications@oscdigitaltool.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
