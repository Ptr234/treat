{
  "name": "uganda-onestopcentre-nextjs",
  "version": "1.1.0",
  "description": "Uganda One Stop Centre - Next.js TypeScript application providing streamlined access to government business services, investment opportunities, and professional support.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@sanity/client": "^8.9.0",
    "@sanity/vision": "^6.18.0",
    "@types/leaflet": "^1.9.21",
    "framer-motion": "^11.11.17",
    "jose": "^6.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.532.0",
    "next": "16.3.8",
    "next-sanity": "^13.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "resend": "^6.16.0",
    "sanity": "^6.18.0",
    "styled-components": "^6.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.61.1",
    "@sanity/cli": "^8.16.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.3.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "16.3.8",
    "jest": "^29.0.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.149.0"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "tailwindcss",
    "uganda",
    "government-services",
    "business-registration",
    "investment-tools",
    "responsive-design",
    "pwa"
  ],
  "author": "Uganda Investment One Stop Center <support@onestopcentre.ug>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ptr234/treat.git"
  },
  "bugs": {
    "url": "https://github.com/Ptr234/treat/issues"
  },
  "homepage": "https://oscdigitaltool.com",
  "overrides": {
    "smol-toml": "^1.9.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.0.0"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.14": true,
    "sharp@0.35.4": true,
    "sharp@0.34.4": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
